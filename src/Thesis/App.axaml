<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Thesis.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Tokens.axaml"/>
                <ResourceInclude Source="/Themes/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Акцент по умолчанию; при запуске ThemeService заменяет его сохранённым -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#4F46E5"/>
                <ColorPaletteResources x:Key="Dark" Accent="#9C97FF"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Themes/Styles.axaml"/>
    </Application.Styles>
</Application>
