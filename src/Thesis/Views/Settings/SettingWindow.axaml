<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Thesis.ViewModels.Settings"
        xmlns:controls="using:Thesis.Controls"
        x:Class="Thesis.Views.Settings.SettingWindow"
        x:DataType="vm:SettingWindowViewModel"
        Title="Настройки"
        Width="620"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Icon.ico">

    <Window.Styles>
        <!-- Карточка выбора темы -->
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Style>
        <Style Selector="Button.choice.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.choice controls|Icon.mark">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.choice.selected controls|Icon.mark">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Образец акцентного цвета -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="28" Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="Настройки"/>
            <TextBlock Classes="secondary" Text="Изменения применяются сразу и сохраняются автоматически."/>
        </StackPanel>

        <!-- ============ Тема ============ -->
        <Border Classes="card" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h3" Text="Тема оформления"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="«Как в системе» автоматически переключается вместе с Windows."/>
                </StackPanel>

                <UniformGrid Columns="3" ColumnSpacing="10">
                    <Button Classes="choice" Classes.selected="{Binding ThemeModes[0].IsSelected}"
                            Command="{Binding SelectThemeModeCommand}" CommandParameter="{Binding ThemeModes[0]}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <controls:Icon Data="{StaticResource Icon.Monitor}" Size="22" HorizontalAlignment="Left"/>
                                <controls:Icon Grid.Column="1" Classes="mark" Data="{StaticResource Icon.Check}" Size="16"
                                               Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="h3" Text="{Binding ThemeModes[0].Title}"/>
                            <TextBlock Grid.Row="2" Classes="caption" Text="{Binding ThemeModes[0].Description}"/>
                        </Grid>
                    </Button>
                    <Button Classes="choice" Classes.selected="{Binding ThemeModes[1].IsSelected}"
                            Command="{Binding SelectThemeModeCommand}" CommandParameter="{Binding ThemeModes[1]}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <controls:Icon Data="{StaticResource Icon.Sun}" Size="22" HorizontalAlignment="Left"/>
                                <controls:Icon Grid.Column="1" Classes="mark" Data="{StaticResource Icon.Check}" Size="16"
                                               Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="h3" Text="{Binding ThemeModes[1].Title}"/>
                            <TextBlock Grid.Row="2" Classes="caption" Text="{Binding ThemeModes[1].Description}"/>
                        </Grid>
                    </Button>
                    <Button Classes="choice" Classes.selected="{Binding ThemeModes[2].IsSelected}"
                            Command="{Binding SelectThemeModeCommand}" CommandParameter="{Binding ThemeModes[2]}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <controls:Icon Data="{StaticResource Icon.Moon}" Size="22" HorizontalAlignment="Left"/>
                                <controls:Icon Grid.Column="1" Classes="mark" Data="{StaticResource Icon.Check}" Size="16"
                                               Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="h3" Text="{Binding ThemeModes[2].Title}"/>
                            <TextBlock Grid.Row="2" Classes="caption" Text="{Binding ThemeModes[2].Description}"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ============ Акцентный цвет ============ -->
        <Border Classes="card" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h3" Text="Акцентный цвет"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="Цвет кнопок, выделения и активных элементов. В тёмной теме автоматически используется более светлый оттенок."/>
                </StackPanel>

                <ItemsControl x:Name="AccentList" ItemsSource="{Binding Accents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccentOption">
                            <Button Classes="swatch" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #AccentList.((vm:SettingWindowViewModel)DataContext).SelectAccentCommand}"
                                    CommandParameter="{Binding}">
                                <Panel>
                                    <Ellipse Fill="{Binding Brush}"/>
                                    <controls:Icon Data="{StaticResource Icon.Check}" Size="16" StrokeThickness="2.5"
                                                   Foreground="White" IsVisible="{Binding IsSelected}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Живой пример: сразу видно, как выглядят элементы с выбранным цветом -->
                <Border Classes="sunken" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Classes="label" Text="Пример"/>
                        <Button Grid.Column="2" Classes="accent" Content="Основная кнопка"/>
                        <ToggleSwitch Grid.Column="3" IsChecked="True" OnContent="" OffContent="" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
