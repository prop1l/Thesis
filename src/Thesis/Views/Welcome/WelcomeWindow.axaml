<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Thesis.ViewModels.Welcome"
        xmlns:controls="using:Thesis.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1150" d:DesignHeight="760"
        x:Class="Thesis.Views.Welcome.WelcomeWindow"
        x:DataType="vm:WelcomeViewModel"
        Title="GraphIS"
        Width="1150" Height="760"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icon.ico">

    <Window.Styles>
        <!-- Карточка графа — это кнопка: клик открывает редактор -->
        <Style Selector="Button.graph-card">
            <Setter Property="Width" Value="350"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.graph-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.graph-card:pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)"/>
        </Style>
        <!-- Кнопки действий на карточке видны всегда, но становятся ярче при наведении на карточку -->
        <Style Selector="Button.graph-card StackPanel.card-actions">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Button.graph-card:pointerover StackPanel.card-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ Шапка ============ -->
        <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <controls:Icon Data="{StaticResource Icon.Graph}" Size="22" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="h3" FontSize="16" Text="GraphIS"/>
                        <TextBlock Classes="caption" Text="Построение графов и поиск кратчайших путей"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="ghost icon" Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="Переключить светлую / тёмную тему">
                        <Panel>
                            <controls:Icon Data="{StaticResource Icon.Moon}" Size="18" IsVisible="{Binding !IsDark}"/>
                            <controls:Icon Data="{StaticResource Icon.Sun}" Size="18" IsVisible="{Binding IsDark}"/>
                        </Panel>
                    </Button>
                    <Button Classes="ghost icon" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Настройки">
                        <controls:Icon Data="{StaticResource Icon.Settings}" Size="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Содержимое ============ -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,16,28" Spacing="24">

                <!-- Заголовок и создание графа -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,16,0">
                    <StackPanel VerticalAlignment="Top" Spacing="4">
                        <TextBlock Classes="h1" Text="Мои графы"/>
                        <TextBlock Classes="secondary" Text="{Binding GraphCountText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="280"
                                     PlaceholderText="Название нового графа"
                                     Text="{Binding NewGraphName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddGraphCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Classes="accent" Command="{Binding AddGraphCommand}">
                                <StackPanel Classes="btn">
                                    <controls:Icon Data="{StaticResource Icon.Plus}" Size="16"/>
                                    <TextBlock Text="Создать"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="caption"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Text="{Binding NameError}"
                                   IsVisible="{Binding HasNameError}"/>
                    </StackPanel>
                </Grid>

                <!-- Пустое состояние -->
                <Border Classes="card" Padding="40" Margin="0,0,16,0" IsVisible="{Binding IsEmpty}">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}">
                            <controls:Icon Data="{StaticResource Icon.Graph}" Size="32"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Classes="h2" Text="Пока нет ни одного графа" HorizontalAlignment="Center"/>
                        <TextBlock Classes="secondary" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                                   Text="Введите название в поле справа вверху и нажмите «Создать». Граф откроется в редакторе по клику на карточку."/>
                    </StackPanel>
                </Border>

                <!-- Карточки графов -->
                <ItemsControl x:Name="GraphsList" ItemsSource="{Binding GraphItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphCardViewModel">
                            <Button Classes="graph-card"
                                    Command="{Binding #GraphsList.((vm:WelcomeViewModel)DataContext).OpenGraphCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Открыть в редакторе">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Открыть"
                                                  Command="{Binding #GraphsList.((vm:WelcomeViewModel)DataContext).OpenGraphCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Переименовать"
                                                  Command="{Binding #GraphsList.((vm:WelcomeViewModel)DataContext).RenameGraphCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить"
                                                  Command="{Binding #GraphsList.((vm:WelcomeViewModel)DataContext).DeleteGraphCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="h3" FontSize="15" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Classes="caption" Text="{Binding KindTitle}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="card-actions" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Classes="ghost icon" Width="30" Height="30"
                                                    Command="{Binding #GraphsList.((vm:WelcomeViewModel)DataContext).RenameGraphCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Переименовать">
                                                <controls:Icon Data="{StaticResource Icon.Pencil}" Size="15"/>
                                            </Button>
                                            <Button Classes="ghost icon danger" Width="30" Height="30"
                                                    Command="{Binding #GraphsList.((vm:WelcomeViewModel)DataContext).DeleteGraphCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Удалить">
                                                <controls:Icon Data="{StaticResource Icon.Trash}" Size="15"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Classes="divider"/>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="caption" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StatsText}"/>
                                        <TextBlock Grid.Column="1" Classes="caption muted" Text="{Binding ModifiedText}"/>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
